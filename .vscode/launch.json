{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Gateway",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",        // 👈 change to your actual module path
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload"
      ],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Debug Test MCP Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cmd/testmcp/main.py",  // 👈 change to your MCP entry point
      "args": ["C:\\tmp"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Debug Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}